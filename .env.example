# Supabase configuration
# Public values may be used by the browser. Never put secrets in VITE_* variables.
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-only secrets. Never expose these with a VITE_ prefix or commit real values.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
LOVABLE_API_KEY=your-lovable-ai-gateway-key

# Browser-safe Supabase configuration (same public values as above).
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
