# Supabase public configuration (same project URL/key for browser and server)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-public-key
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-public-key

# Server-only secrets. Never add the VITE_ prefix to these values.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
LOVABLE_API_KEY=your-lovable-ai-gateway-key
